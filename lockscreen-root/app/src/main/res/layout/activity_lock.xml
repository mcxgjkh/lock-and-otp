<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical"
    android:paddingLeft="@dimen/screen_padding"
    android:paddingTop="@dimen/screen_padding"
    android:paddingRight="@dimen/screen_padding"
    android:paddingBottom="@dimen/screen_padding">

    <TextClock
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textColor="#FFFFFFFF"
        android:textSize="@dimen/clock_text" />

    <TextView
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:textColor="#99FFFFFF"
        android:textSize="@dimen/date_text" />

    <TextView
        android:id="@+id/tv_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:minHeight="18dp"
        android:textColor="#FFFF6B6B"
        android:textSize="@dimen/msg_text" />

    <LinearLayout
        android:id="@+id/dots"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal" />

    <!-- 占满剩余空间：按键随可用高度伸缩，方屏/圆屏/极小屏都不会溢出 -->
    <FrameLayout
        android:id="@+id/cred_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/pin_pad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/key_1"
                    style="@style/PadKey"
                    android:text="1" />

                <Button
                    android:id="@+id/key_2"
                    style="@style/PadKey"
                    android:text="2" />

                <Button
                    android:id="@+id/key_3"
                    style="@style/PadKey"
                    android:text="3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/key_4"
                    style="@style/PadKey"
                    android:text="4" />

                <Button
                    android:id="@+id/key_5"
                    style="@style/PadKey"
                    android:text="5" />

                <Button
                    android:id="@+id/key_6"
                    style="@style/PadKey"
                    android:text="6" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/key_7"
                    style="@style/PadKey"
                    android:text="7" />

                <Button
                    android:id="@+id/key_8"
                    style="@style/PadKey"
                    android:text="8" />

                <Button
                    android:id="@+id/key_9"
                    style="@style/PadKey"
                    android:text="9" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/key_del"
                    style="@style/PadKey"
                    android:text="⌫" />

                <Button
                    android:id="@+id/key_0"
                    style="@style/PadKey"
                    android:text="0" />

                <Button
                    android:id="@+id/key_ok"
                    style="@style/PadKey"
                    android:text="✓" />
            </LinearLayout>
        </LinearLayout>

        <com.mcxgjkh.lockscreen.ui.PatternView
            android:id="@+id/pattern_view"
            android:layout_width="@dimen/pattern_size"
            android:layout_height="@dimen/pattern_size"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="4dp"
        android:text="@string/switch_to_pin"
        android:textColor="#994FC3F7"
        android:textSize="@dimen/hint_text"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="#66FFFFFF"
        android:textSize="@dimen/hint_text" />
</LinearLayout>
